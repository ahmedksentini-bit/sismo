{
 "chapitre": "ch6",
 "exercices": [
  {
   "id": "ch6-profil",
   "titre": "Vitesses et épaisseur de la croûte par deux droites",
   "difficulte": 2,
   "graine": 1126151445,
   "enonce": "Sur un profil, quatre stations lisent la première arrivée P d'un séisme localisé à 14 km de profondeur (temps depuis l'origine) : 45 km, 7,99 s ; 100 km, 17,11 s ; 170 km, 27,12 s ; 290 km, 42,50 s. Les deux premières sont avant le croisement (Pg), les deux dernières au-delà (Pn).",
   "donnees": [
    {
     "label": "Pg à 45 km",
     "valeur": "7,99 s"
    },
    {
     "label": "Pg à 100 km",
     "valeur": "17,11 s"
    },
    {
     "label": "Pn à 170 km",
     "valeur": "27,12 s"
    },
    {
     "label": "Pn à 290 km",
     "valeur": "42,50 s"
    }
   ],
   "questions": [
    {
     "texte": "Vitesse de la croûte V₁ (pente des deux premières) ?",
     "type": "nombre",
     "unite": "km/s",
     "reponse": 6.0307,
     "explication": "V₁ = (100 − 45) / (17,11 − 7,99) = 6,03 km/s (modèle : 5,9 ; près du foyer Pg n'est pas encore droite).",
     "toleranceRel": 0.03
    },
    {
     "texte": "Vitesse du manteau V₂ ?",
     "type": "nombre",
     "unite": "km/s",
     "reponse": 7.80234,
     "explication": "V₂ = (290 − 170) / (42,50 − 27,12) = 7,80 km/s.",
     "toleranceRel": 0.02
    },
    {
     "texte": "Temps d'intercept tᵢ de Pn ?",
     "type": "nombre",
     "unite": "s",
     "reponse": 5.33167,
     "explication": "tᵢ = t − Δ/V₂ = 27,12 − 170 / 7,80 = 5,33 s.",
     "tolerance": 0.25
    },
    {
     "texte": "Épaisseur de la croûte H ?",
     "type": "nombre",
     "unite": "km",
     "reponse": 32.3384,
     "explication": "cos iᶜ = √(1 − (V₁/V₂)²) = 0,634 ; H = (tᵢ·V₁/cos iᶜ + h)/2 = (5,33 × 6,03 / 0,634 + 14)/2 = 32,3 km (modèle : 31 km).",
     "toleranceRel": 0.06
    }
   ]
  },
  {
   "id": "ch6-croisement",
   "titre": "Distance critique et distance de croisement",
   "difficulte": 1,
   "graine": 1765252106,
   "enonce": "Une croûte de 25 km d'épaisseur (V₁ = 5,9 km/s) repose sur un manteau à V₂ = 8,1 km/s. Le séisme est à 13 km de profondeur.",
   "donnees": [
    {
     "label": "V₁, V₂",
     "valeur": "5,9 et 8,1 km/s"
    },
    {
     "label": "H, h",
     "valeur": "25 km, 13 km"
    }
   ],
   "questions": [
    {
     "texte": "Angle critique iᶜ ?",
     "type": "nombre",
     "unite": "°",
     "reponse": 46.752,
     "explication": "sin iᶜ = V₁/V₂ = 0,728, iᶜ = 46,8°.",
     "tolerance": 0.5
    },
    {
     "texte": "Temps d'intercept tᵢ ?",
     "type": "nombre",
     "unite": "s",
     "reponse": 4.29675,
     "explication": "tᵢ = (2H − h)·cos iᶜ/V₁ = (50 − 13) × 0,685 / 5,9 = 4,30 s.",
     "toleranceRel": 0.03
    },
    {
     "texte": "Distance critique, où Pn apparaît ?",
     "type": "nombre",
     "unite": "km",
     "reponse": 39.3349,
     "explication": "(2H − h)·tan iᶜ = 37 × 1,063 = 39 km.",
     "toleranceRel": 0.03
    },
    {
     "texte": "À 54 km, la première onde P est…",
     "type": "choix",
     "options": [
      "l'onde de Rayleigh",
      "Pn",
      "Sg",
      "Pg"
     ],
     "reponse": 3,
     "explication": "Pg arrive à √(54² + 13²)/5,9 = 9,41 s, Pn à 54/8,1 + 4,30 = 10,96 s : la distance de croisement vaut 90 km."
    }
   ]
  },
  {
   "id": "ch6-site",
