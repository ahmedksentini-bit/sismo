   "difficulte": 1,
   "graine": 939310964,
   "enonce": "Une ligne de géophones donne deux droites de premières arrivées : la première, issue de l'origine, de vitesse 650 m/s ; la seconde de vitesse 3200 m/s et d'ordonnée à l'origine 41,6 ms. Le tir est en surface.",
   "donnees": [
    {
     "label": "V₁",
     "valeur": "650 m/s"
    },
    {
     "label": "V₂",
     "valeur": "3200 m/s"
    },
    {
     "label": "tᵢ",
     "valeur": "41,6 ms"
    }
   ],
   "questions": [
    {
     "texte": "Profondeur du substratum H ?",
     "type": "nombre",
     "unite": "m",
     "reponse": 13.8079,
     "explication": "cos iᶜ = √(1 − (650/3200)²) = 0,979 ; H = tᵢ·V₁/(2 cos iᶜ) = 0,0416 × 650 / (2 × 0,979) = 13,81 m.",
     "toleranceRel": 0.03
    },
    {
     "texte": "Distance de croisement ?",
     "type": "nombre",
     "unite": "m",
     "reponse": 33.9325,
     "explication": "Les deux droites se coupent où x/V₁ = x/V₂ + tᵢ : x = tᵢ / (1/V₁ − 1/V₂) = 33,9 m.",
     "toleranceRel": 0.03
    },
    {
     "texte": "Pour lire correctement la vitesse du substratum, la ligne de géophones doit…",
     "type": "choix",
     "options": [
      "être parallèle à la nappe",
      "être enterrée sous le substratum",
      "s'étendre à 2 ou 3 fois la distance de croisement",
      "rester plus courte que la distance de croisement"
     ],
     "reponse": 2,
     "explication": "Il faut plusieurs géophones au-delà du croisement pour tracer la seconde droite."
    }
   ]
  },
